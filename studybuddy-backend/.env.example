DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=studybuddy
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=studybuddy_oss
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1
WECHAT_ENABLED=false
# Optional integrations. Empty COS settings use local uploads/ storage.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=

# 开启微信时必须填写以下三项；内部 token 与 Bot 的同名变量一致
WECHAT_BOT_SERVICE_URL=http://127.0.0.1:8011
WECHAT_BOT_INTERNAL_TOKEN=
# 家长打开的绑定页面（部署时改成自己的客户端 HTTPS 地址）
WECHAT_PARENT_INVITATION_URL=http://127.0.0.1:5173/#/wechat-parent-bind
# 公众号是另一种可选通道；iLink Bot 不需要以下凭据
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OFFICIAL_ACCOUNT_QR_URL=
WECHAT_ACCESS_TOKEN_URL=https://api.weixin.qq.com/cgi-bin/token
WECHAT_CUSTOMER_MESSAGE_URL=https://api.weixin.qq.com/cgi-bin/message/custom/send
