# hobbybuddy 后端环境变量（Secret/连接信息，不入库）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=studybuddy
DB_PASSWORD=changeme
DB_NAME=hobbybuddy

# JWT_SECRET 至少 16 位（底座 config 校验 min_length=16）
JWT_SECRET=changeme_to_random_string
JWT_EXPIRE_HOURS=24
JWT_REMEMBER_LOGIN_HOURS=720

APP_PORT=8002

# MiMo LLM（复用与知了相同的模型账号）
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1

# 微信在底座默认关闭；兴趣应用无需配置微信。
WECHAT_ENABLED=false
