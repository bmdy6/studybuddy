# 可选服务：仅在明确启用微信时，导出本文件变量再启动。
# iLink 协议地址（官方网关，不是私人服务）
WECHAT_BOT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com/
# iLink Bot 类型
WECHAT_BOT_ILINK_TYPE=3
# iLink 应用标识
WECHAT_BOT_ILINK_APP_ID=bot
# iLink 客户端协议版本
WECHAT_BOT_ILINK_CLIENT_VERSION=132102
# 本地扫码授权有效期（秒）
WECHAT_BOT_AUTHORIZATION_TIMEOUT_SECONDS=180
# 每次扫码状态轮询超时（秒）
WECHAT_BOT_AUTHORIZATION_POLL_TIMEOUT_SECONDS=2
# HTTP 请求超时（秒）
WECHAT_BOT_REQUEST_TIMEOUT_SECONDS=10
# 学习后端接收微信入站消息的内部端点
WECHAT_BOT_BACKEND_MESSAGE_URL=http://127.0.0.1:8001/api/internal/channels/wechat/ilink/messages
# 学习后端列出已绑定账号的内部端点
WECHAT_BOT_BACKEND_ACCOUNTS_URL=http://127.0.0.1:8001/api/internal/channels/wechat/ilink/accounts
# 与后端完全相同的随机内部密钥，务必自行替换
WECHAT_BOT_INTERNAL_TOKEN=replace_with_random_shared_secret
# 本机独立凭据目录；保存扫码后的账号 token，禁止提交
HERMES_HOME=/absolute/path/to/wechat-bot-hermes
# 发送分片重试次数，至少 1
WECHAT_BOT_SEND_CHUNK_RETRIES=1
# 分片间延时（秒）
WECHAT_BOT_SEND_CHUNK_DELAY_SECONDS=0
# 分片重试延时（秒）
WECHAT_BOT_SEND_CHUNK_RETRY_DELAY_SECONDS=0
# 仅本机监听；跨主机请自行配置安全内网
WECHAT_BOT_LISTEN_HOST=127.0.0.1
# Bot HTTP 监听端口
WECHAT_BOT_LISTEN_PORT=8011
