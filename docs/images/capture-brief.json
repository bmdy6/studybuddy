{
  "webCapture": {
    "setup": [
      "cd studybuddy-backend && PYTHONPATH=. .venv/bin/python ../docs/images/seed-demo.py"
    ],
    "prepare": [],
    "data": "docs/images/seed-demo.py: disposable MySQL readme_demo_test, fictional student, prefilled plan draft/task history/answer record; no model calls",
    "env": {
      "DB_HOST": "127.0.0.1",
      "DB_PORT": "13317",
      "DB_USER": "readme_demo",
      "DB_PASSWORD": "synthetic-readme-only",
      "DB_NAME": "readme_demo_test",
      "JWT_SECRET": "synthetic-readme-demo-jwt-secret-not-for-real-use",
      "LLM_API_KEY": "",
      "LLM_BASE_URL": "http://127.0.0.1:9",
      "WECHAT_ENABLED": "false",
      "CORS_ORIGINS": "http://127.0.0.1:15173",
      "VITE_API_BASE": "http://127.0.0.1:18011"
    },
    "services": [
      {
        "command": "cd studybuddy-backend && PYTHONPATH=. .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 18011",
        "readyUrl": "http://127.0.0.1:18011/health"
      },
      {
        "command": "cd studybuddy-client && npm run dev -- --host 127.0.0.1 --port 15173 --strictPort",
        "readyUrl": "http://127.0.0.1:15173/"
      }
    ],
    "pages": [
      {
        "id": "overview",
        "url": "http://127.0.0.1:15173/#/study-plans",
        "viewport": {
          "width": 1280,
          "height": 800
        },
        "waitFor": "text=分数加法",
        "storageState": "docs/images/plan-state.private.json"
      },
      {
        "id": "plan-confirm",
        "url": "http://127.0.0.1:15173/#/chat",
        "viewport": {
          "width": 1280,
          "height": 800
        },
        "waitFor": "text=确认并创建",
        "storageState": "docs/images/plan-state.private.json"
      },
      {
        "id": "task-session",
        "url": "http://127.0.0.1:15173/#/chat",
        "viewport": {
          "width": 1280,
          "height": 800
        },
        "waitFor": "text=作答记录（预填演示）",
        "storageState": "docs/images/task-state.private.json"
      },
      {
        "id": "resume",
        "url": "http://127.0.0.1:15173/#/study-plans/all",
        "viewport": {
          "width": 1280,
          "height": 800
        },
        "waitFor": "text=分数加法",
        "storageState": "docs/images/task-state.private.json"
      }
    ],
    "timeoutMs": 20000
  },
  "install": {
    "block": "cd studybuddy-backend\npython3.11 -m venv .venv\n.venv/bin/python -m pip install -r requirements.txt\ncp .env.example .env"
  }
}
